<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5"
    tools:context=".activity.SplashActivity">

    <!-- Logo SmartFood -->
    <ImageView
        android:id="@+id/imgSplashLogo"
        android:layout_width="1300dp"
        android:layout_height="130dp"
        android:src="@drawable/logo"
        android:scaleType="fitCenter"
        android:contentDescription="SmartFood Logo"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/txtSplashName"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Tên ứng dụng -->
    <TextView
        android:id="@+id/txtSplashName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SmartFood"
        android:textColor="#2E7D32"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif"
        app:layout_constraintTop_toBottomOf="@id/imgSplashLogo"
        app:layout_constraintBottom_toTopOf="@id/txtSplashSlogan"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Slogan -->
    <TextView
        android:id="@+id/txtSplashSlogan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quản lý thực phẩm thông minh"
        android:textColor="#789078"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/txtSplashName"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
