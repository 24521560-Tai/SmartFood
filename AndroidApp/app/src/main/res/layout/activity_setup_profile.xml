<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- ================= HEADER ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Thiết lập hồ sơ"
                android:textColor="#757575"
                android:textSize="16sp" />

            <!-- khoảng trống để tiêu đề nằm chính giữa -->
            <View
                android:layout_width="32dp"
                android:layout_height="32dp" />

        </LinearLayout>

        <!-- ================= GREETING ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="Xin chào bạn! 👋"
            android:textColor="#2E7D32"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Hãy tạo hồ sơ để bắt đầu sử dụng Smart Food nhé."
            android:textColor="#757575"
            android:textSize="15sp" />


        <!-- ================= AVATAR HIỆN TẠI ================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSelectedAvatar"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8F5E9"
            app:strokeWidth="2dp">

            <ImageView
                android:id="@+id/imgSelectedAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/avatar_carrot"
                android:contentDescription="Avatar hiện tại" />

        </com.google.android.material.card.MaterialCardView>


        <!-- Chọn ảnh đại diện -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Chọn ảnh đại diện"
            android:textColor="#2E7D32"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- ================= TÊN HIỂN THỊ ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Tên hiển thị"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:boxBackgroundMode="filled"
            app:boxBackgroundColor="#F5F7F5"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="0dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nhập tên bạn muốn hiển thị"
                android:inputType="textPersonName"
                android:textSize="16sp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ================= AVATAR ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Chọn avatar yêu thích"
            android:textColor="#263238"
            android:textSize="16sp"
            android:textStyle="bold" />


        <!-- Grid avatar -->

        <GridLayout
            android:id="@+id/avatarGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:columnCount="4"
            android:rowCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="false">


            <!-- Avatar 1 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard1"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#2E7D32"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/avatar1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_carrot"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 1" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 2 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard2"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_broccoli"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 2" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 3 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard3"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_tomato"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 3" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 4 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard4"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_cabbage"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 4" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 5 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard5"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar5"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_corn"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 5" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 6 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard6"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar6"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_avocado"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 6" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 7 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard7"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar7"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_orange"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 7" />

            </com.google.android.material.card.MaterialCardView>


            <!-- Avatar 8 -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/avatarCard8"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_margin="4dp"
                android:layout_columnWeight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#EEEEEE"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/avatar8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:src="@drawable/avatar_chili"
                    android:scaleType="fitCenter"
                    android:contentDescription="Avatar 8" />

            </com.google.android.material.card.MaterialCardView>

        </GridLayout>


        <!-- ================= BUTTON ================= -->

        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2E7D32"
            android:text="Bắt đầu sử dụng"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />


        <!-- ================= NOTE ================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Bạn có thể thay đổi hồ sơ sau trong phần cá nhân."
            android:textColor="#8A8A8A"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>